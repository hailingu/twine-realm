{
  "openapi": "3.1.0",
  "info": {
    "title": "twine-realm 本地项目 API",
    "version": "1.0.0",
    "description": "一期单机、单可信 OS 用户；没有账号系统。共享 JSON Schema 是字段契约来源。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "responses": {
          "200": {
            "description": "已确认的持久结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ProjectList"
                }
              }
            }
          },
          "default": {
            "description": "安全的机器可读错误；未知提交须核实原 mutationId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "responses": {
          "201": {
            "description": "已确认的持久结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "安全的机器可读错误；未知提交须核实原 mutationId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Twine-Request",
            "in": "header",
            "required": true,
            "schema": {
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "精确匹配启动时配置的本机来源"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/CreateCommand"
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "responses": {
          "200": {
            "description": "已确认的持久结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Project"
                }
              }
            }
          },
          "default": {
            "description": "安全的机器可读错误；未知提交须核实原 mutationId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/projects/{id}/services": {
      "post": {
        "operationId": "registerRepository",
        "responses": {
          "201": {
            "description": "已确认的持久结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "安全的机器可读错误；未知提交须核实原 mutationId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Twine-Request",
            "in": "header",
            "required": true,
            "schema": {
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "精确匹配启动时配置的本机来源"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/RegisterCommand"
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}/layout": {
      "put": {
        "operationId": "saveLayout",
        "responses": {
          "200": {
            "description": "已确认的持久结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "安全的机器可读错误；未知提交须核实原 mutationId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Twine-Request",
            "in": "header",
            "required": true,
            "schema": {
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "精确匹配启动时配置的本机来源"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/LayoutCommand"
              }
            }
          }
        }
      }
    },
    "/api/v1/mutations/{id}": {
      "get": {
        "operationId": "getMutationReceipt",
        "responses": {
          "200": {
            "description": "已确认的持久结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "安全的机器可读错误；未知提交须核实原 mutationId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  }
}
