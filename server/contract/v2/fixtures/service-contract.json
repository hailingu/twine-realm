{
  "id": "example.service",
  "version": "1.0.0",
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": { "logLevel": { "type": "string", "enum": ["info", "debug"] } }
  },
  "interfaces": [
    { "id": "http.api", "version": "1.0.0", "protocol": "http", "schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": { "requestId": { "type": "string" } }, "additionalProperties": false } },
    { "id": "http.api", "version": "2.0.0", "protocol": "http", "schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": { "requestId": { "type": "string" }, "traceId": { "type": "string" } }, "additionalProperties": false } }
  ],
  "ports": [
    { "id": "database", "role": "consume", "protocol": "mysql", "contract": "mysql-wire/10", "cardinality": "one", "required": true },
    { "id": "http-v1", "role": "provide", "protocol": "http", "contract": "http.api@1.0.0", "cardinality": "many", "required": false },
    { "id": "http-v2", "role": "provide", "protocol": "http", "contract": "http.api@2.0.0", "cardinality": "many", "required": false }
  ]
}
