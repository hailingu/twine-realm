{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twine-realm.local/contract/v3/build-artifacts.schema.json",
  "title": "build-artifacts.schema.json",
  "type": "object",
  "$defs": {
    "BuildCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "toolVersion",
        "outputDigest",
        "completedAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "enum": [
            "succeeded"
          ]
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "BuildMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "BuildImage": {
      "description": "实际本地引擎ID与Buildx的config、manifest/index内容摘要分别保存，不能假设ID恒等于config digest。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestDigest",
        "configDigest",
        "tag",
        "binaryDigest"
      ],
      "properties": {
        "id": {
          "description": "实际Docker image inspect返回的ID，必须严格等于已检查config或manifest/index摘要之一。",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binaryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "BuildCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetId",
        "operationId",
        "inputDigest",
        "sourceDigest",
        "profile",
        "template",
        "environment",
        "checks",
        "migrations",
        "migrationDigest",
        "image",
        "createdAt",
        "source",
        "policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "targetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildIdentity"
        },
        "template": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildIdentity"
        },
        "environment": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildEnvironment"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "https://twine-realm.local/contract/v3/build-artifacts.schema.json#/$defs/BuildCheck"
          },
          "maxItems": 32
        },
        "migrations": {
          "type": "array",
          "items": {
            "$ref": "https://twine-realm.local/contract/v3/build-artifacts.schema.json#/$defs/BuildMigration"
          },
          "maxItems": 512
        },
        "migrationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image": {
          "$ref": "https://twine-realm.local/contract/v3/build-artifacts.schema.json#/$defs/BuildImage"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildSource"
        },
        "policy": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildPolicy"
        }
      }
    }
  }
}
