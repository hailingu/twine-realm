{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twine-realm.local/contract/v3/build-inputs.schema.json",
  "title": "build-inputs.schema.json",
  "type": "object",
  "$defs": {
    "BuildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "BuildSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "projectRevision",
        "serviceId",
        "repositoryId",
        "repositoryPath",
        "pinnedCommit"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "projectRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "serviceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "repositoryId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "repositoryPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pinnedCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "BuildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "daemonId",
        "dockerVersion",
        "buildxVersion",
        "builderName",
        "buildkitVersion",
        "imageId",
        "imageReference",
        "architecture",
        "operatingSystem",
        "bindSourceMode",
        "uid",
        "gid",
        "endpointDigest"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "daemonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dockerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "buildxVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "builderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "buildkitVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "imageId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "imageReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "operatingSystem": {
          "const": "linux"
        },
        "bindSourceMode": {
          "enum": [
            "canonical",
            "desktop-host-mnt-v1"
          ]
        },
        "uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "endpointDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "BuildPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "totalSeconds",
        "commandSeconds",
        "sourceBytes",
        "sourceFiles",
        "binaryBytes",
        "memoryMiB",
        "tmpfsMiB",
        "pids",
        "cpus"
      ],
      "properties": {
        "id": {
          "const": "go-container-local-v1"
        },
        "version": {
          "const": 1
        },
        "totalSeconds": {
          "const": 480
        },
        "commandSeconds": {
          "const": 180
        },
        "sourceBytes": {
          "const": 67108864
        },
        "sourceFiles": {
          "const": 4096
        },
        "binaryBytes": {
          "const": 134217728
        },
        "memoryMiB": {
          "const": 4096
        },
        "tmpfsMiB": {
          "const": 3072
        },
        "pids": {
          "const": 256
        },
        "cpus": {
          "const": 2
        }
      }
    },
    "BuildTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "serviceId",
        "generation",
        "canvasRevision",
        "installationId",
        "source",
        "profile",
        "environment",
        "policy",
        "inputDigest",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "serviceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "canvasRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "installationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "source": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildSource"
        },
        "profile": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildIdentity"
        },
        "environment": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildEnvironment"
        },
        "policy": {
          "$ref": "https://twine-realm.local/contract/v3/build-inputs.schema.json#/$defs/BuildPolicy"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
