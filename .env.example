# 复制为 .env 并 chmod 600；分别生成随机秘密，禁止提交真实值。
TWINE_DB_ROOT_PASSWORD=
TWINE_DB_PASSWORD=
TWINE_DB_USER=twine
TWINE_DB_NAME=twine_realm
TWINE_DB_PORT=3307
TWINE_ADDRESS=127.0.0.1:8080
# JSON 数组：必须按本机实际仓库范围填写，不允许根目录 /。
TWINE_REPOSITORY_ROOTS=
# 运行执行器默认禁用；先按 mysql-runtime-slice.md 初始化仓库外全新私有根，再显式填写两项。
TWINE_RUNTIME_ADAPTER=
TWINE_RUNTIME_DIRECTORY=
